# ==========================================
# EKAFY Platform & Wedapola Configuration
# ==========================================

NODE_ENV=production
PORT=3000

# Primary Domain & Host (for Traefik Routing)
APP_HOST=wedapola.ekafy.com

# Database Configuration (EKAFY Standard)
DB_HOST=ekafy-mariadb
DB_PORT=3306
DB_NAME=db_tenant_wedapola
DB_USER=ekafy_admin
DB_PASSWORD=your_secure_db_password
DATABASE_URL=mysql://ekafy_admin:your_secure_db_password@ekafy-mariadb:3306/db_tenant_wedapola

# Redis Queue & Cache (EKAFY Standard)
REDIS_HOST=ekafy-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Must be the same OAuth Web/server client ID configured as mobile's serverClientId.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage Abstraction (local or s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/storage
PUBLIC_STORAGE_BASE_URL=https://wedapola.ekafy.com/storage

# Cloudflare R2 / AWS S3 Storage (Set STORAGE_PROVIDER=s3 to activate)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=wedapola
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PUBLIC_DOMAIN=https://cdn.wedapola.com

# Firebase Cloud Messaging (FCM HTTP v1)
FIREBASE_PROJECT_ID=wedapola-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@wedapola-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...-----END PRIVATE KEY-----\n"

# WhatsApp Business Cloud API (Sri Lanka Notification Fallback)
WHATSAPP_API_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Google Maps API (Geospatial & Address Autocomplete)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
